{
  "name": "proyecto-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA offline-first para reportes de servicio tecnico",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/fechas.test.js test/validacion.test.js test/api.test.js test/pwa.test.js",
    "test:unit": "node --test test/fechas.test.js test/validacion.test.js",
    "test:api": "node --test test/api.test.js",
    "test:pwa": "node --test test/pwa.test.js",
    "test:e2e": "node scripts/e2e-offline.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.13.1"
  }
}
